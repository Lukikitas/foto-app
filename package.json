{
  "name": "foto-app",
  "private": true,
  "version": "1.14.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test src/lib/*.test.js",
    "test:ui": "node tests/ui/run-performance.mjs && node tests/ui/run-performance.mjs --mobile && npm run test:native-handoff",
    "test:native-handoff": "node tests/ui/run-native-camera.mjs && node tests/ui/run-native-camera.mjs --desktop && node tests/ui/run-native-camera.mjs --rollback",
    "prepare:thumbnails": "node scripts/prepare-thumbnail-assets.mjs",
    "test:database": "node tests/database/run-isolated.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "@tesseract.js-data/eng": "^1.0.0",
